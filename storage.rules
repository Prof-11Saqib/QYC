rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Payment screenshots ───────────────────
    match /screenshots/{fileName} {

      // WRITE: anyone can upload any image, max 5MB
      // Generic — no filename restrictions
      allow write: if
        request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // READ: needed to generate download URL after upload
      allow read: if true;
    }

    // Block everything outside screenshots folder
    match /{allOtherPaths=**} {
      allow read, write: if false;
    }
  }
}